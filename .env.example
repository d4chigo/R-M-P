# Environment Configuration
NODE_ENV=development

# Database Configuration
MYSQL_ROOT_PASSWORD=rootpass123
MYSQL_DATABASE=rmp_db
MYSQL_USER=rmp_user
MYSQL_PASSWORD=rmp_password123

# Database Access (for application)
DB_HOST=mysql
DB_PORT=3306
DB_USER=rmp_user
DB_PASSWORD=rmp_password123
DB_NAME=rmp_db

# JWT Configuration
JWT_SECRET=
JWT_EXPIRES_IN=24h

# Port Configuration
CLIENT_PORT=3000
SERVER_PORT=4000
MYSQL_PORT=3306
PHPMYADMIN_PORT=8080

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# SMTP Configuration
SMTP_HOST=smtp.gmail.com # Gmail SMTP (recommended for development)
SMTP_PORT=587 # Use 587 for TLS
SMTP_USER=josechalan99@gmail.com # Gmail email address
SMTP_PASS= loganz18# Use an app password for Gmail, not your regular password

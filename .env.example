# Environment Configuration
NODE_ENV=development

# Database Configuration
MYSQL_ROOT_PASSWORD=your_root_password
MYSQL_DATABASE=your_database_name
MYSQL_USER=your_database_user
MYSQL_PASSWORD=your_database_password

# Port Configuration
CLIENT_PORT=3000
SERVER_PORT=4000
MYSQL_PORT=3306
PHPMYADMIN_PORT=8080

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# SMTP Configuration
SMTP_HOST=smtp.gmail.com # Gmail SMTP (recommended for development)
SMTP_PORT=587 # Use 587 for TLS
SMTP_USER=tu_email@gmail.com # Gmail email address
SMTP_PASS=tu_app_password_aqui # Use an app password for Gmail, not your regular password

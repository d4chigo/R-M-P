# ===========================================
# CONFIGURACIÓN DE VARIABLES DE ENTORNO
# RMP - Route Management Platform
# ===========================================

# Environment Configuration
NODE_ENV=development

# Database Configuration
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=rmp_db
MYSQL_USER=rmp_user
MYSQL_PASSWORD=

# Database Access (for application)
DB_HOST=mysql
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=rmp_db

# JWT Configuration
JWT_SECRET=
JWT_EXPIRES_IN=24h

# Port Configuration
CLIENT_PORT=3000
SERVER_PORT=4000
MYSQL_PORT=3306
PHPMYADMIN_PORT=8080

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# SMTP Configuration
SMTP_HOST=smtp.gmail.com # Gmail SMTP (recommended for development)
SMTP_PORT=587 # Use 587 for TLS
SMTP_USER= # Gmail account or SMTP account
SMTP_PASS= # SMTP app password
